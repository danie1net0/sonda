{
    "name": "danielneto/sonda",
    "description": "Prototype: source-instrumented line and branch coverage for PHP, faster than Xdebug path coverage",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "nikic/php-parser": "^5.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Sonda\\": "src/"
        }
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
